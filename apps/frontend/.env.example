# Frontend (Vite) environment
# Copy to apps/frontend/.env when running locally.
# Only variables prefixed with VITE_ are exposed to the browser.

VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_MAPS_API_KEY=
# Map ID vector tạo trên Cloud Console, style ẩn đường gắn vào đó (docs/plan/map-first-layout-plan.md §2.1)
VITE_GOOGLE_MAPS_MAP_ID=
VITE_APP_NAME=Agentic RAG Lich Su
