# Frontend (Vite) environment
# Copy to apps/frontend/.env when running locally.
# Only variables prefixed with VITE_ are exposed to the browser.

VITE_API_BASE_URL=http://localhost:8000
# OAuth client ID (cùng giá trị GOOGLE_CLIENT_ID ở root .env). Client ID là public, lộ ra
# bundle là bình thường. Rỗng -> KHÔNG render nút "Đăng nhập với Google".
VITE_GOOGLE_CLIENT_ID=
VITE_APP_NAME=Agentic RAG Lich Su
