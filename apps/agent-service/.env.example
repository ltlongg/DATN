# Agent-service environment
# Copy to apps/agent-service/.env when running outside docker-compose.

AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=9000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Vector store
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=history_vn_chunks

# Graph store
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password_change_me

# Cache
REDIS_URL=redis://localhost:6379/0

# LLM / embedding
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3
HYBRID_ENABLED=true
GRAPHRAG_ENABLED=true
