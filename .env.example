# ============================================================
# Environment Variables for Agentic RAG Lich Su VN  (TEMPLATE)
#
# Copy thành .env ở GỐC repo rồi điền giá trị thật:
#   cp .env.example .env
#
# Đây là NGUỒN SỰ THẬT DUY NHẤT cho cả 3 service. docker-compose nạp .env này cho
# backend/agent-service/frontend và override hostname theo tên container khi chạy
# Docker. Khi chạy local, pydantic-settings (config.py) đọc trực tiếp file này.
# Mỗi service vẫn có .env.example riêng làm tài liệu cho biến đặc thù của nó.
# ============================================================

# ---------- LLM & OpenAI Configuration ----------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Để trống nếu dùng api.openai.com; điền nếu đi qua gateway OpenAI-compatible.
OPENAI_BASE_URL=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Guardrails input layer: model riêng nhỏ/rẻ kiểm câu hỏi trước khi vào flow (không fallback
# sang LLM_MODEL). Xem docs/plan/guardrails-input-plan.md.
GUARDRAILS_LLM_MODEL=gpt-4o-mini
# Embedding dùng model tiếng Việt (HuggingFace), KHÔNG phải OpenAI.
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding

# ---------- Agent-service runtime ----------
AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=9000
ENVIRONMENT=development
LOG_LEVEL=INFO
RAG_TOP_K=20
RAG_SCORE_THRESHOLD=0.3
HYBRID_ENABLED=true
GRAPHRAG_ENABLED=true

# ---------- Qdrant ----------
# Local dev: dùng host thật/localhost. docker-compose override QDRANT_HOST=qdrant.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=qdrant_secure_api_key_here

# ---------- Neo4j ----------
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secure_password_here
# Bolt dùng cổng 7687 (7474 là HTTP browser).
NEO4J_URI=bolt://localhost:7687

# ---------- Redis ----------
# Local dev: redis://localhost:6379/0 | docker-compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ---------- PostgreSQL ----------
POSTGRES_DB=agentic_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_here
# Local dev: ...@localhost:5432/db | docker-compose: ...@postgres:5432/db
DATABASE_URL=postgresql+psycopg://postgres:postgres_secure_password_here@localhost:5432/agentic_rag
# Connection pool (psycopg_pool) — giữ sẵn connection thay vì mở/đóng mỗi request.
# Áp dụng cho cả backend lẫn agent-service. Bỏ trống = dùng mặc định (min 1, max 10).
PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=10

# ---------- Service URLs & Auth ----------
BACKEND_PORT=8000
FRONTEND_PORT=5173
AGENT_SERVICE_URL=http://localhost:9000
# Secret key cho JWT (sinh bằng: openssl rand -hex 32)
BACKEND_SECRET_KEY=generate_some_secure_hex_key_here

# Shared secret cho 2 chiều gọi HTTP NỘI BỘ giữa backend và agent-service (header
# X-Internal-Key): backend -> POST /ask, /kb/* ; agent-service -> GET /internal/config.
# KHÔNG liên quan JWT của user (JWT = "user nào", key này = "service nào").
# BẮT BUỘC có giá trị — để rỗng thì 2 service từ chối gọi nhau (fail-closed, KHÔNG bỏ qua
# check). Sinh bằng: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=generate_another_secure_hex_key_here

# ---------- Google Maps ----------
# Geocode địa danh -> lat/lon (Geocoding API) + render bản đồ (Maps JavaScript API).
# Bật cả 2 API cho key. Rỗng -> geocoder bỏ Google, chỉ dùng LLM fallback.
# ToS: chỉ cache lat/lon <= 30 ngày — xem docs/reference/google-maps-api.md.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Tuỳ chọn: Map ID cho AdvancedMarkerElement / vector map (mặc định DEMO_MAP_ID).
GOOGLE_MAPS_MAP_ID=
