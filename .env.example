# ============================================================
# Environment Variables for Agentic RAG Lich Su VN
# ============================================================

# ---------- LLM & OpenAI Configuration ----------
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ---------- PostgreSQL Configuration ----------
POSTGRES_DB=agentic_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_here
# Database URL for backend (local dev): postgresql+psycopg://user:pass@localhost:5432/db
# Database URL for docker-compose: postgresql+psycopg://user:pass@postgres:5432/db
DATABASE_URL=postgresql+psycopg://postgres:postgres_secure_password_here@localhost:5432/agentic_rag

# ---------- Redis Configuration ----------
# Redis URL for local dev: redis://localhost:6379/0
# Redis URL for docker-compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=redis_secure_password_here

# ---------- Neo4j Configuration ----------
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secure_password_here
# Neo4j URI for local dev: bolt://localhost:7687
# Neo4j URI for docker-compose: bolt://neo4j:7687
NEO4J_URI=bolt://localhost:7687

# ---------- Qdrant Configuration ----------
# Qdrant URL for local dev: http://localhost:6333
# Qdrant URL for docker-compose: http://qdrant:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=qdrant_secure_api_key_here

# ---------- Service URLs ----------
BACKEND_PORT=8000
AGENT_SERVICE_PORT=9000
FRONTEND_PORT=5173

# Secret key for JWT auth (generate using openssl rand -hex 32)
BACKEND_SECRET_KEY=generate_some_secure_hex_key_here
AGENT_SERVICE_URL=http://localhost:9000
